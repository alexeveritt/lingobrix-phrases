    {
      "letter": "v",
      "name": "uve",
      "say": "uve",
      "ph": "OO-beh",
      "word": "ventana",
      "wordEn": "window",
      "tip": "Sounds exactly like b in Spanish, so take care when spelling.",
      "alt": [
        {
          "name": "ve",
          "say": "ve",
          "ph": "beh",
          "why": "'Ve' is the usual name in most of Latin America. In Spain people say 'uve' so it doesn't sound like 'be'."
        },
        {
          "name": "ve baja",
          "say": "ve baja",
          "ph": "beh BAH-hah",
          "why": "In Latin America people say 've baja' or 've corta' (low/short v) to tell it from b ('be alta'). Spain says 'uve'."
        }
      ]
    },
    {
      "letter": "w",
      "name": "uve doble",
      "say": "uve doble",
      "ph": "OO-beh DOH-bleh",
      "word": "wifi",
      "wordEn": "wifi",
      "tip": "Only used in borrowed words like wifi and web.",
      "alt": [
        {
          "name": "doble uve",
          "say": "doble uve",
          "ph": "DOH-bleh OO-beh",
          "why": "Many people in Spain say 'doble uve' — it means the same, 'double v'."
        },
        {
          "name": "doble ve",
          "say": "doble ve",
          "ph": "DOH-bleh beh",
          "why": "The usual name in Latin America ('double v'). In Spain you'll hear 'uve doble' instead."
        }
      ]
    },
