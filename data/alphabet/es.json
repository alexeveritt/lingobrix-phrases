      "ph": "KOH-moh seh ehs-KREE-beh"
    },
    {
      "en": "How do you spell your name?",
      "tx": "¿Cómo se escribe tu nombre?",
      "ph": "KOH-moh seh ehs-KREE-beh too NOHM-breh"
    },
    {
      "en": "It's spelled …",
      "tx": "Se escribe…",
      "ph": "seh ehs-KREE-beh"
    },
    {
      "en": "Can you spell that?",
      "tx": "¿Me lo puedes deletrear?",
      "ph": "meh loh PWEH-dehs deh-leh-treh-AHR"
    },
    {
      "en": "with a capital letter",
      "tx": "con mayúscula",
      "ph": "kohn mah-YOOS-koo-lah"
    },
    {
      "en": "with double r (two r's)",
      "tx": "con dos erres",
      "ph": "kohn dohs EH-rrehs"
