{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the home page and every language site (see src/worker.js).
  // Cloudflare runs `npm run build` then `npx wrangler deploy` on every push to main.
  "name": "lingobrix",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "account_id": "42e72c1dffd0d3a8c15bf94b1366d1a3", // Bytechaser
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // the Worker picks the folder from the hostname, so it runs before any asset is served
    "run_worker_first": true
  },
  "workers_dev": true,
  // builds from branches other than main get their own preview URL
  "preview_urls": true,
  // `wrangler dev` would otherwise pretend every request is for lingobrix.com;
  // on localhost the Worker serves dist/ as-is, so /es/, /de/ and /fr/ all work
  "dev": { "host": "localhost" },
  "observability": { "enabled": true },
  // Custom domains. A hostname can only be added once nothing else uses it
  // (no DNS record, not attached to a Pages project).
  "routes": [
    { "pattern": "lingobrix.com", "custom_domain": true },
    { "pattern": "www.lingobrix.com", "custom_domain": true }
  ]
}
